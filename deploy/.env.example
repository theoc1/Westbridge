# Westbridge settings matching deploy/docker-compose.yml.
# Copy to deploy/.env and load with:  set -a; . ./deploy/.env; set +a
#
# The backend runs on the host and reaches Asterisk through the published
# AMI port, so the address is loopback, not the container name.
WB_LISTEN=:8080
WB_AMI_ADDR=127.0.0.1:5038
WB_AMI_USER=westbridge
WB_AMI_SECRET=westbridge-secret
# Only used to import the legacy room on the first upgrade of an existing DB.
WB_ROOM=1000
# Reserve the same range in the internal dialplan (default _7XXX).
WB_ROOM_MIN=7000
WB_ROOM_MAX=7999
WB_ORIGINATE_CONTEXT=conference-out
# Quoted because of the angle brackets — this file is meant to be sourced.
WB_ORIGINATE_CALLERID="Westbridge <1000>"
WB_ORIGINATE_TIMEOUT=30s
WB_RESYNC_INTERVAL=30s

# Local HTTP only. Keep true (the default) when serving behind HTTPS.
WB_COOKIE_SECURE=false
WB_DB_PATH=data/westbridge.db
